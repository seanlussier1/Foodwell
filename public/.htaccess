# Front controller: send every non-file request to index.php.
# Requires mod_rewrite and AllowOverride All for this directory.
Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On
# Apache hides the Authorization header from PHP by default, so bearer logins
# would fail with 401 on every protected route. Pass it through; PHP then sees it
# as HTTP_AUTHORIZATION or, after the rewrite to index.php, REDIRECT_HTTP_AUTHORIZATION.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
