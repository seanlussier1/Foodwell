                        "exec": [
                            "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.test(\"Stock equals the adjustment's stockAfter\", () => pm.expect(pm.response.json().stock).to.eql(Number(pm.collectionVariables.get(\"stockNow\"))));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Record damage as admin",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}"
                    }
                ],
                "url": "{{baseUrl}}/products/101/inventory-adjustments",
                "body": {
                    "mode": "raw",
                    "raw": "{\"quantityChange\": -2, \"reason\": \"damage\"}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                            "const a = pm.response.json();",
                            "pm.test(\"Admin is recorded as the actor (10)\", () => pm.expect(a.actorId).to.eql(10));",
                            "pm.test(\"Starts from the previous balance\", () => pm.expect(a.stockBefore).to.eql(Number(pm.collectionVariables.get(\"stockNow\"))));",
                            "pm.test(\"A missing note is null\", () => pm.expect(a.note).to.eql(null));",
                            "pm.collectionVariables.set(\"stockNow\", a.stockAfter);"
                        ]
                    }
                }
            ]
        },
