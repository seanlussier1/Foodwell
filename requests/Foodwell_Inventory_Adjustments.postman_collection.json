        {
            "name": "Restock as staff",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{staffToken}}"
                    }
                ],
                "url": "{{baseUrl}}/products/101/inventory-adjustments",
                "body": {
                    "mode": "raw",
                    "raw": "{\"quantityChange\": 12, \"reason\": \"restock\", \"note\": \"Tuesday delivery\"}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                            "const a = pm.response.json();",
                            "const before = Number(pm.collectionVariables.get(\"stockBefore\"));",
                            "pm.test(\"Balances are calculated by the server\", () => { pm.expect(a.stockBefore).to.eql(before); pm.expect(a.stockAfter).to.eql(before + 12); });",
                            "pm.test(\"The actor is the signed-in staff account (9)\", () => pm.expect(a.actorId).to.eql(9));",
                            "pm.test(\"Reason and note are kept\", () => { pm.expect(a.reason).to.eql(\"restock\"); pm.expect(a.note).to.eql(\"Tuesday delivery\"); });",
                            "pm.test(\"Location points at the new adjustment\", () => pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/inventory-adjustments/\" + a.id + \"$\")));",
                            "pm.collectionVariables.set(\"adjustmentId\", a.id);",
                            "pm.collectionVariables.set(\"stockNow\", a.stockAfter);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Product stock really changed",
            "request": {
                "method": "GET",
                "header": [
