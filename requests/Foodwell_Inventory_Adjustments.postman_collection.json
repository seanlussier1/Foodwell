            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"stockBefore\", pm.response.json().stock);",
                            "pm.test(\"Stock is a whole number\", () => pm.expect(pm.response.json().stock).to.be.a(\"number\"));"
