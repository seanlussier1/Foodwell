{
    "info": {
        "name": "Foodwell Inventory Adjustments",
        "description": "Inventory adjustments (Will): staff/admin stock changes with an append-only audit log. Covers 401/403, server-calculated balances and actor, 422 validation, 409 stock limits, 404, 415, paginated history, reading one adjustment, 405 on edits and the product-delete rule. Run with composer test:inventory, which provides a disposable database with the synthetic demo accounts. To send it by hand, use a disposable database (php scripts/db-setup.php) and set baseUrl.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Sign in as staff",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{baseUrl}}/auth/sessions",
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\": \"staff@example.com\", \"password\": \"FoodwellDemo!2026\"}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                            "pm.collectionVariables.set(\"staffToken\", pm.response.json().accessToken);"
                        ]
                    }
                }
            ]
        },
