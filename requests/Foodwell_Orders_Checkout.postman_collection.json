{
  "info": {
    "name": "Foodwell Order and Checkout Integrity",
    "description": "Uses the disposable schema and synthetic demo accounts provisioned by composer test:orders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sign in as alex",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"alex@example.com\",\"password\":\"FoodwellDemo!2026\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const response = pm.response.json();",
              "pm.collectionVariables.set(\"alexToken\", response.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as sam",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"sam@example.com\",\"password\":\"FoodwellDemo!2026\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const response = pm.response.json();",
              "pm.collectionVariables.set(\"samToken\", response.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as staff",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"staff@example.com\",\"password\":\"FoodwellDemo!2026\"}"
        }
      },
