# Copy to .env and adjust. Never commit .env.
DB_HOST=127.0.0.1
# Wamp MariaDB may use 3307; check your local settings.
DB_PORT=3306
DB_NAME=foodwell
DB_USER=foodwell
DB_PASS=change_me

# Leave empty for `composer start`. In Wamp (htdocs/foodwell-api) use /foodwell-api
APP_BASE_PATH=
# Local synthetic-data profile demo only; keep disabled on shared/deployed servers.
APP_CUSTOMER_PROFILE_DEMO=0

# Separate browser client origins, comma-separated. Same-origin requests also work.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
